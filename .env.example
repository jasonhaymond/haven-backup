# Copy to .env and edit, or run ./scripts/setup.sh to generate it interactively.
# docker-compose.yml reads this file automatically. Every value below has a
# safe built-in default in backend/app/config.py if left unset here.

# --- Host port ---
# The port on THIS machine that the portal's web UI (Caddy, serving the SPA
# and proxying /api) is published on. Put your own reverse proxy in front of
# this for TLS before exposing it beyond a trusted network -- see docs/DEPLOYMENT.md.
WEB_PORT=8080

# --- Notifications ---
# Generic webhook (ntfy/Discord/Slack-compatible adapter URL) for health-transition
# and prune-failure alerts. Leave unset to disable notifications entirely.
HAVEN_NOTIFICATION_WEBHOOK_URL=

# --- Scheduling ---
# How often (minutes) every repo's status is refreshed via `borg info`/`list`.
HAVEN_STATUS_REFRESH_MINUTES=30
# How often (hours) the scheduled retention prune runs against every repo.
HAVEN_PRUNE_INTERVAL_HOURS=24
# Max seconds any single borg/borgmatic/ssh command is allowed to run.
HAVEN_COMMAND_TIMEOUT=3600

# --- Sessions & login ---
# How long a login session lasts, in seconds. Default: 14 days.
HAVEN_SESSION_MAX_AGE=1209600
# A real browser refuses to even store a cookie marked Secure over plain HTTP --
# defaults to "false" because the bundled `web` container (Caddy) serves plain
# HTTP on WEB_PORT out of the box. Once you put a real TLS-terminating reverse
# proxy in front of WEB_PORT, set this to "true" and restart -- see
# docs/DEPLOYMENT.md and docs/SECURITY.md.
HAVEN_COOKIE_SECURE=false
# Login/setup rate limiting: max attempts per window, per client IP.
HAVEN_LOGIN_RATE_LIMIT_ATTEMPTS=10
HAVEN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Logging ---
HAVEN_LOG_LEVEL=INFO

# --- Advanced / rarely needed ---
# Extra flags appended to the ssh command borg uses via BORG_RSH (e.g. to pin
# a non-standard known_hosts file). See docs/SECURITY.md.
HAVEN_BORG_SSH_EXTRA_OPTS=
