[Unit]
Description=Haven Backup - full backup run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# If you use passphrase-derived key mode (see docs/DISASTER_RECOVERY.md),
# set it here instead of a key file -- prefer EnvironmentFile over inlining
# the passphrase directly in a world-readable unit file:
# EnvironmentFile=/etc/haven-backup.env
ExecStart=/opt/haven-backup/.venv/bin/haven-backup backup --type full
ExecStartPost=/opt/haven-backup/.venv/bin/haven-backup healthcheck

[Install]
WantedBy=multi-user.target
